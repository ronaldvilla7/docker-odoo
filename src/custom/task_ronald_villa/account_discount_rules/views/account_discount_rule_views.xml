<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_account_discount_rule_tree" model="ir.ui.view">
        <field name="name">account.discount.rule.tree</field>
        <field name="model">account.discount.rule</field>
        <field name="arch" type="xml">
            <tree string="Discount Rules">
                <field name="name"/>
                <field name="customer_type"/>
                <field name="discount_percentage"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_account_discount_rule_form" model="ir.ui.view">
        <field name="name">account.discount.rule.form</field>
        <field name="model">account.discount.rule</field>
        <field name="arch" type="xml">
            <form string="Discount Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g., Regular VIP Discount"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_type"/>
                            <field name="discount_percentage"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_account_discount_rule" model="ir.actions.act_window">
        <field name="name">Discount Rules</field>
        <field name="res_model">account.discount.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item in Accounting Configuration -->
    <menuitem id="menu_account_discount_rules"
              name="Discount Rules"
              parent="account.menu_finance_configuration"
              action="action_account_discount_rule"
              sequence="20"/>
</odoo>
