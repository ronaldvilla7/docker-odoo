<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View (Tablero) -->
    <record id="view_account_financial_kpi_kanban" model="ir.ui.view">
        <field name="name">account.financial.kpi.kanban</field>
        <field name="model">account.financial.kpi</field>
        <field name="arch" type="xml">
            <kanban string="Financial Indicators" create="1">
                <field name="name"/>
                <field name="current_value"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_color_{{record.color.raw_value}}">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-2 text-center" style="font-size: 24px; font-weight: bold;">
                                    <field name="current_value" widget="float"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_account_financial_kpi_tree" model="ir.ui.view">
        <field name="name">account.financial.kpi.tree</field>
        <field name="model">account.financial.kpi</field>
        <field name="arch" type="xml">
            <tree string="KPIs Configuration">
                <field name="name"/>
                <field name="formula"/>
                <field name="current_value"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_account_financial_kpi_form" model="ir.ui.view">
        <field name="name">account.financial.kpi.form</field>
        <field name="model">account.financial.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g., Current Liquidity"/></h1>
                    </div>
                    <group>
                        <group name="formula_group" string="Data and Calculation">
                            <field name="formula" placeholder="bal('11') / bal('21')"/>
                            <field name="current_value" readonly="1" force_save="1"/>
                        </group>
                        <group name="thresholds_group" string="Thresholds (Traffic Light)">
                            <field name="threshold_direction"/>
                            <field name="threshold_warning"/>
                            <field name="threshold_critical"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_account_financial_kpi_dashboard" model="ir.actions.act_window">
        <field name="name">Salud Financiera</field>
        <field name="res_model">account.financial.kpi</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create the first Financial KPI
          </p>
        </field>
    </record>

    <!-- Configuration Action -->
    <record id="action_account_financial_kpi_config" model="ir.actions.act_window">
        <field name="name">Configurar KPIs</field>
        <field name="res_model">account.financial.kpi</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <!-- Dashboard -> Reporting -->
    <menuitem id="menu_account_financial_kpi_dashboard"
              name="Financial Health (KPIs)"
              parent="account.menu_finance_reports"
              action="action_account_financial_kpi_dashboard"
              sequence="105"/>

    <!-- Configuration -> Settings -->
    <menuitem id="menu_account_financial_kpi_config"
              name="Financial Indicators"
              parent="account.menu_finance_configuration"
              action="action_account_financial_kpi_config"
              sequence="110"/>

</odoo>
