<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_storage_tag_wizard_form" model="ir.ui.view">
        <field name="name">stock.storage.tag.wizard.form</field>
        <field name="model">stock.storage.tag.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Storage Tags">
                <group>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_apply_tags" string="Assign" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Action Window as Wizard for Product Template -->
    <record id="action_open_stock_storage_tag_wizard" model="ir.actions.act_window">
        <field name="name">Assign Etiquetas</field>
        <field name="res_model">stock.storage.tag.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
    </record>
</odoo>
